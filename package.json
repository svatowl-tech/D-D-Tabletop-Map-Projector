{
  "name": "vtt-zero-tabletop-projector",
  "version": "1.0.0",
  "description": "Ultra-lightweight tabletop RPG map projector & fog-of-war tool with zero-latency BroadcastChannel sync for Windows, macOS, Linux, and web.",
  "author": "VTT-Zero Team",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/SvatOwl/vtt-zero-tabletop-projector",
  "repository": {
    "type": "git",
    "url": "https://github.com/SvatOwl/vtt-zero-tabletop-projector.git"
  },
  "keywords": [
    "dnd",
    "vtt",
    "tabletop",
    "battlemap",
    "projector",
    "fog-of-war",
    "dual-screen",
    "offline-first",
    "hardware-accelerated"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release-artifacts standalone.html",
    "lint": "tsc --noEmit",
    "build:standalone": "tsx scripts/build-standalone.ts",
    "package:release": "tsx scripts/package-releases.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
